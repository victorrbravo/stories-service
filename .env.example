# Copy to .env and fill in your own values. Never commit .env.

# Local database (used by cmd/auth and tests)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stories
DB_USER=stories
DB_PASS=stories

# Remote database (used by some integration tests)
REMOTE_DB_HOST=
REMOTE_DB_PASS=

# JWT signing secrets
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Email (Resend)
API_RESEND_KEY=
URL_VERIFY_EMAIL=https://doitall.work/confirm/
URL_CHANGE_PASSWORD=
URL_RESEND_EMAIL=

# SMTP (alternative mailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# AI providers
OPEN_API_KEY=
GOOGLE_API_KEY=

# AWS (S3 presigned URLs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Workflow engine
WORKFLOW_URL=
SHOW_EMPTY_TASKS=
