# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Used by `npm run dev` on the host
DATABASE_URL=postgres://stories:stories@localhost:5432/stories
# Used by docker compose (localhost inside the container is the container itself)
DOCKER_DATABASE_URL=postgres://stories:stories@host.docker.internal:5432/stories
PORT=3000
# Host port docker compose publishes the service on (7070 on the server)
AUTH_PORT=3000
# Comma-separated list of frontends allowed to call the API with cookies
TRUSTED_ORIGINS=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=false
# Set to true when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# Optional: without it emails are printed to the console
API_RESEND_KEY=
EMAIL_FROM=DoItAll <support@doitall.work>
# Resend template (id or alias) sent on sign-up
RESEND_SIGNUP_TEMPLATE=signup
